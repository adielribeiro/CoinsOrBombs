{
  "name": "coins-or-bombs",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Jogo isometrico de mineracao e risco: coins or bombs, feito com React + Phaser + Vite.",
  "license": "MIT",
  "keywords": [
    "game",
    "phaser",
    "react",
    "isometric",
    "roguelite",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "test": "node --test \"test/*.test.mjs\"",
    "pages": "npm run build && node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "vite": "^7.1.3",
    "@vitejs/plugin-react": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
} 